# Copy to .env.local and set locally; never commit the real key.
# This is a documented credential name; no dotenv loader exists yet.
TYPESAFE_API_KEY=

# OpenAI model for discovery drafts and prose. Account access is unverified.
OPENAI_API_KEY=
OPENAI_PROSE_MODEL=gpt-5-nano

# Resolve this alias to a returned model ID before freezing final evaluations.
TYPESAFE_MODEL=jev-latest
